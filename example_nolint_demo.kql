// Comprehensive demonstration of nolint comment styles

// Disable all rules for current line
.create table temp_staging_data (id: int, value: string) //nolint:

// Disable specific rule for current line
.create table another_legacy_table (id: int, data: string) //nolint:table-naming

// Multiple rules (even though we only have one rule currently)
.create table multi_rule_example (id: int) //nolint:table-naming,other-rule

// SQL-style comment with nolint
.create table old_api_data (id: int, response: string) -- nolint:table-naming

// Mixed comment styles in one file - all should be ignored
.create table style_one (id: int) //nolint:table-naming
.create table style_two (id: int) -- nolint:table-naming
.create table style_three (id: int) //nolint:

// This table will be flagged since it has no disable comment
.create table should_be_flagged (id: int, value: string)

// Proper naming that follows PascalCase (no violations)
.create table ProperlyNamedTable (id: int, name: string)