// Comprehensive demonstration of both klint-disable and nolint comment styles

// Original klint-disable style
.create table legacy_user_data (id: int, name: string) // klint-disable table-naming -- Required for backward compatibility

// Go-style nolint - disable all klint rules
.create table temp_staging_data (id: int, value: string) //nolint:klint

// Go-style nolint - disable specific rule
.create table another_legacy_table (id: int, data: string) //nolint:table-naming

// Multiple rules with nolint (even though we only have one rule)
.create table multi_rule_example (id: int) //nolint:table-naming,other-rule

// SQL-style comment with klint-disable
.create table old_api_data (id: int, response: string) -- klint-disable table-naming

// Next-line disable (klint-disable style only, nolint doesn't support this)
// klint-disable-next-line table-naming
.create table disabled_next_line (id: int, value: string)

// Mixed styles in one file - all should be ignored
.create table style_one (id: int) // klint-disable table-naming
.create table style_two (id: int) //nolint:table-naming  
.create table style_three (id: int) -- klint-disable table-naming
.create table style_four (id: int) //nolint:klint

// This table will be flagged since it has no disable comment
.create table should_be_flagged (id: int, value: string)

// Proper naming that follows PascalCase (no violations)
.create table ProperlyNamedTable (id: int, name: string)