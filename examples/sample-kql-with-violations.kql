// Sample KQL file to demonstrate LSP diagnostics
// This file contains various table naming violations for testing

// This should trigger a warning (snake_case instead of PascalCase)
.create table user_data (
    id: int,
    name: string,
    email: string
)

// This should trigger a warning (kebab-case instead of PascalCase)  
.create table user-metrics (
    user_id: int,
    login_count: int,
    last_login: datetime
)

// This is correct (PascalCase)
.create table UserProfiles (
    userId: int,
    profileData: string,
    createdAt: datetime
)

// This should trigger a warning (SCREAMING_SNAKE_CASE instead of PascalCase)
.create table USER_SESSIONS (
    session_id: string,
    user_id: int,
    start_time: datetime
)

// Example of using tables in queries (should also be detected)
UserProfiles 
| where userId > 100
| join user_data on $left.userId == $right.id
| project name, profileData