// Demonstration of inline disable comments for klint

// This table violates PascalCase but is disabled for the current line
.create table legacy_user_data (id: int, name: string) // klint-disable table-naming -- Required for backward compatibility

// This table also violates naming but uses SQL-style comment
.create table temp_staging_data (id: int, value: string) -- klint-disable table-naming

// Using next-line disable comment
// klint-disable-next-line table-naming
.create table another_legacy_table (id: int, data: string)

// Disabling all rules on current line
.create table bad_naming_example (id: int) // klint-disable

// This table will be flagged since it has no disable comment
.create table another_bad_name (id: int, value: string)

// Multiple rule disable (even though we only have one rule currently)
.create table multi_rule_disable (id: int) // klint-disable table-naming,other-rule

// Disable with detailed reasoning
.create table external_api_data (id: int, response: string) // klint-disable table-naming -- Must match external API naming convention

// Normal table that follows PascalCase (no violations)
.create table ProperlyNamedTable (id: int, name: string)